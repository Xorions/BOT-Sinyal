# Dapatkan token dari @BotFather di Telegram, lalu isi di file .env (bukan di sini)
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan (bisa pakai @userinfobot untuk mengecek ID kamu)
TELEGRAM_CHAT_ID=

# Opsional: free API key CoinGecko (https://www.coingecko.com/en/api).
# Tanpa key masih jalan tapi lambat karena kuota publik kecil.
COINGECKO_API_KEY=

# Opsional: jumlah koin teratas yang dipantau (default 10)
TOP_COINS=10

# Opsional: ambang skor sinyal (default 3.0 untuk BUY, -3.0 untuk SELL)
BUY_THRESHOLD=3.0
SELL_THRESHOLD=-3.0
